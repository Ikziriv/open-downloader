<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent template for Open Downloader headless daemon.
  Installed to: ~/Library/LaunchAgents/com.opendownloader.daemon.plist
  Placeholders replaced by scripts/install.sh: {{BIN_PATH}}, {{LOG_DIR}}
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.opendownloader.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{BIN_PATH}}</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/open-downloader.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/open-downloader.err.log</string>
</dict>
</plist>
