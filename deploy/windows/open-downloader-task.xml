<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler template for Open Downloader headless daemon.
  Install via: .\scripts\install.ps1 -AutoStart   (or: od autostart enable)
  Placeholders replaced by installer: {{BIN_PATH}}, {{WORK_DIR}}
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Open Downloader background daemon (REST API, SSE, and MCP)</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Hidden>true</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{BIN_PATH}}</Command>
      <Arguments>serve</Arguments>
      <WorkingDirectory>{{WORK_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
