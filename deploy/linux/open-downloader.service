# Linux systemd user service template for Open Downloader headless daemon.
# Installed to: ~/.config/systemd/user/open-downloader.service
# Placeholders replaced by scripts/install.sh: {{BIN_PATH}}, {{WORK_DIR}}

[Unit]
Description=Open Downloader Headless Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{BIN_PATH}} serve
WorkingDirectory={{WORK_DIR}}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
